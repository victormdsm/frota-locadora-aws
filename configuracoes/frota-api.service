# /etc/systemd/system/frota-api.service
[Unit]
Description=Frota Locadora, API Spring Boot
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/frota.env
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /home/ubuntu/frota-api.jar
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
